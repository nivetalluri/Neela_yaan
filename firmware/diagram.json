{
  "version": 1,
  "author": "Neela Yaan software prototype",
  "editor": "wokwi",
  "parts": [
    { "type": "board-stm32-bluepill", "id": "mcu", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "temp", "top": -60, "left": 270, "attrs": {"value": "130"} },
    { "type": "wokwi-potentiometer", "id": "battery", "top": 100, "left": 270, "attrs": {"value": "820"} }
  ],
  "connections": [
    ["temp:SIG", "mcu:A0", "green", []],
    ["temp:VCC", "mcu:3V3.1", "red", []],
    ["temp:GND", "mcu:GND.1", "black", []],
    ["battery:SIG", "mcu:A1", "blue", []],
    ["battery:VCC", "mcu:3V3.1", "red", []],
    ["battery:GND", "mcu:GND.1", "black", []],
    ["mcu:A9", "$serialMonitor:RX", "orange", []],
    ["mcu:A10", "$serialMonitor:TX", "orange", []]
  ]
}
